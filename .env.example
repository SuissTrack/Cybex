# ─── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=kairos
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=kairos_db
DATABASE_URL=postgresql://kairos:change_me_in_production@localhost:5432/kairos_db

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@localhost:6379

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── AI ────────────────────────────────────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-...

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ─── Email (optional, for password reset) ─────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=Kairos <noreply@example.com>

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Scraper ───────────────────────────────────────────────────────────────────
SCRAPER_CRON=0 */6 * * *
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_MS=30000

# ─── Adzuna API (gratuit — https://developer.adzuna.com/) ──────────────────────
# Inscription en 1 min, clé instantanée. 250 req/jour en free tier.
# Sans ces clés, le scraper Adzuna est automatiquement ignoré.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
