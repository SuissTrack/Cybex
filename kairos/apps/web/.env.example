# URL du proxy Cloudflare Worker
# En dev local : laisser vide (Vite proxy /proxy → localhost:8787)
# En production : https://kairos-proxy.votre-domaine.workers.dev
VITE_PROXY_URL=

# ─── Supabase (Phase 2) ───────────────────────────────────────────────────────
# Obtenez ces valeurs dans votre dashboard Supabase → Settings → API
# https://app.supabase.com/project/<project-id>/settings/api
#
# Laissez vide pour fonctionner en mode démo (sans authentification)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
