{
  "name": "kairos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "proxy:dev": "pnpm --filter proxy dev",
    "typecheck": "pnpm -r typecheck"
  }
}
